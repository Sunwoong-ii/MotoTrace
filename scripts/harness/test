#!/usr/bin/env bash
# 단위 테스트를 시뮬레이터에서 실행하고 결과를 요약한다.
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
. "$here/lib.sh"

usage() {
  cat <<'EOF'
사용법: scripts/harness/test [--scheme 스킴] [--only 대상]... [--generate]

  기본: 앱 스킴으로 app.unitTestTargets의 테스트만 실행한다 (UI 테스트 제외).
  성공하면 한 줄, 실패하면 실패한 테스트와 메시지를 출력한다.

  --scheme 스킴   이 스킴의 테스트 액션을 실행한다 (모듈 스킴 등)
  --only 대상      -only-testing 대상: 타깃, 타깃/클래스, 타깃/클래스/메서드. 여러 번 쓸 수 있다
  --generate      변경이 없어도 프로젝트를 다시 생성한다 (Tuist·XcodeGen)

산출물 (.harness/out/): test.log(원본 로그), test.xcresult(결과 번들)
EOF
}

scheme=""
only=""
force_generate=""
while [ $# -gt 0 ]; do
  case "$1" in
    --scheme) [ $# -ge 2 ] || harness_die "--scheme에 스킴 이름이 필요합니다"; scheme="$2"; shift ;;
    --only) [ $# -ge 2 ] || harness_die "--only에 대상이 필요합니다"; only="$only$2"$'\n'; shift ;;
    --generate) force_generate=force ;;
    -h|--help) usage; exit 0 ;;
    *) echo "test: 알 수 없는 인자: $1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

harness_init
harness_container_args
harness_destination
if [ -z "$scheme" ]; then
  scheme="$(cfg .app.scheme)"
  [ -n "$scheme" ] || harness_die "설정에 app.scheme이 없습니다"
  if [ -z "$only" ]; then
    only="$(jq -r '.app.unitTestTargets // [] | .[]' "$config")"
    if [ -z "$only" ]; then
      echo "· test $scheme · 실행할 테스트 없음 (app.unitTestTargets가 비어 있음)"
      exit 0
    fi
  fi
fi

only_args=()
while IFS= read -r target; do
  if [ -n "$target" ]; then only_args+=("-only-testing:$target"); fi
done <<EOF
$only
EOF

start=$SECONDS
harness_ensure_generated "$force_generate" || exit 1

log="$out_dir/test.log"
result="$out_dir/test.xcresult"
rm -rf "$result"

set +e
# bash 3.2는 빈 배열을 "${arr[@]}"로 펼치면 오류가 나서 ${arr[@]+...} 형태로 쓴다.
xcodebuild test "${container_args[@]}" \
  -scheme "$scheme" \
  -destination "$destination" \
  -derivedDataPath "$derived_data" \
  -resultBundlePath "$result" \
  -quiet ${only_args[@]+"${only_args[@]}"} > "$log" 2>&1
code=$?
set -e
elapsed=$((SECONDS - start))

summary="$(harness_test_summary "$result")"
total=0
failed=0
skipped=0
if [ -n "$summary" ]; then
  total="$(printf '%s' "$summary" | jq '.totalTestCount // 0')"
  failed="$(printf '%s' "$summary" | jq '.failedTests // 0')"
  skipped="$(printf '%s' "$summary" | jq '.skippedTests // 0')"
fi
note=""
if [ "$generated_now" = 1 ]; then note=" (generate 포함)"; fi
skip_note=""
if [ "$skipped" -gt 0 ]; then skip_note=" · 건너뜀 $skipped"; fi

if [ "$code" -eq 0 ]; then
  if [ "$total" -eq 0 ]; then
    echo "✓ test $scheme · 실행된 테스트 없음 · ${elapsed}s$note"
  else
    echo "✓ test $scheme · 통과 $((total - skipped))$skip_note · ${elapsed}s$note"
  fi
  exit 0
fi

if [ "$failed" -gt 0 ]; then
  echo "✗ test $scheme 실패 · 실패 $failed / 전체 $total · ${elapsed}s$note"
  harness_print_test_failures "$result" "$summary"
  if [ "$failed" -gt "$max_errors" ]; then echo "  … 실패 $((failed - max_errors))개 더 있음"; fi
else
  # 테스트가 돌기 전에 멈췄다(빌드 실패, 스킴에 테스트 액션 없음 등).
  json="$(harness_build_results "$result")"
  echo "✗ test $scheme 실패 · 테스트 실행 전 중단 (빌드 에러 $(build_count "$json" errorCount)) · ${elapsed}s$note"
  harness_print_build_errors "$json" "$log"
fi
harness_print_artifacts "$log" "$result"
exit "$code"
