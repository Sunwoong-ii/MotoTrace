#!/usr/bin/env bash
# 앱(또는 지정한 스킴)을 시뮬레이터용으로 빌드하고 결과를 요약한다.
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
. "$here/lib.sh"

usage() {
  cat <<'EOF'
사용법: scripts/harness/build [--scheme 스킴] [--generate]

  .harness/project.json의 앱 스킴을 시뮬레이터용으로 빌드한다.
  성공하면 한 줄, 실패하면 첫 에러부터 위치와 메시지를 출력한다.

  --scheme 스킴   앱 대신 이 스킴을 빌드한다
  --generate      변경이 없어도 프로젝트를 다시 생성한다 (Tuist·XcodeGen)

산출물 (.harness/out/): build.log(원본 로그), build.xcresult(결과 번들)
EOF
}

scheme=""
force_generate=""
while [ $# -gt 0 ]; do
  case "$1" in
    --scheme) [ $# -ge 2 ] || harness_die "--scheme에 스킴 이름이 필요합니다"; scheme="$2"; shift ;;
    --generate) force_generate=force ;;
    -h|--help) usage; exit 0 ;;
    *) echo "build: 알 수 없는 인자: $1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

harness_init
harness_container_args
harness_destination
scheme="${scheme:-$(cfg .app.scheme)}"
[ -n "$scheme" ] || harness_die "설정에 app.scheme이 없습니다"

start=$SECONDS
harness_ensure_generated "$force_generate" || exit 1

log="$out_dir/build.log"
result="$out_dir/build.xcresult"
rm -rf "$result"

set +e
xcodebuild build "${container_args[@]}" \
  -scheme "$scheme" \
  -destination "$destination" \
  -derivedDataPath "$derived_data" \
  -resultBundlePath "$result" \
  -quiet > "$log" 2>&1
code=$?
set -e
elapsed=$((SECONDS - start))

json="$(harness_build_results "$result")"
errors="$(build_count "$json" errorCount)"
warnings="$(build_count "$json" warningCount)"
note=""
if [ "$generated_now" = 1 ]; then note=" (generate 포함)"; fi

if [ "$code" -eq 0 ]; then
  echo "✓ build $scheme · $destination_label · ${elapsed}s$note · 경고 $warnings"
  exit 0
fi

echo "✗ build $scheme 실패 · 에러 $errors · 경고 $warnings · ${elapsed}s$note"
harness_print_build_errors "$json" "$log"
harness_print_artifacts "$log" "$result"
exit "$code"
